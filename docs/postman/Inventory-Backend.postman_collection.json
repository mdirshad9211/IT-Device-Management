    {
      "name": "Admin — Permissions",
      "description": "GET: SUPER_ADMIN, DGN_IT_MANAGER, SERVICE_MANAGER. PUT/reset: SUPER_ADMIN only.",
      "item": [
        {
          "name": "GET permission matrix",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/admin/permissions"
          }
        },
        {
          "name": "PUT permission matrix (Super Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matrix\": {\n    \"Device\": {\n      \"view\": [\"SUPER_ADMIN\", \"DGN_IT_MANAGER\", \"SERVICE_MANAGER\", \"IT_ENGINEER\", \"CLIENT_MANAGER\", \"EMPLOYEE\"],\n      \"edit\": [\"SUPER_ADMIN\", \"DGN_IT_MANAGER\", \"SERVICE_MANAGER\", \"IT_ENGINEER\"],\n      \"delete\": [\"DGN_IT_MANAGER\"]\n    },\n    \"OtherNetworkDevice\": {\n      \"view\": [\"SUPER_ADMIN\", \"DGN_IT_MANAGER\", \"SERVICE_MANAGER\", \"IT_ENGINEER\", \"CLIENT_MANAGER\", \"EMPLOYEE\"],\n      \"edit\": [\"SUPER_ADMIN\", \"DGN_IT_MANAGER\", \"SERVICE_MANAGER\", \"IT_ENGINEER\"],\n      \"delete\": [\"DGN_IT_MANAGER\"]\n    },\n    \"Client\": {\n      \"view\": [\"SUPER_ADMIN\", \"DGN_IT_MANAGER\", \"SERVICE_MANAGER\", \"IT_ENGINEER\", \"CLIENT_MANAGER\", \"EMPLOYEE\"],\n      \"edit\": [\"SUPER_ADMIN\", \"DGN_IT_MANAGER\", \"SERVICE_MANAGER\"],\n      \"delete\": [\"DGN_IT_MANAGER\"]\n    }\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/permissions"
          }
        },
        {
          "name": "POST reset permissions (Super Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/admin/permissions/reset"
          }
        }
      ]
    },
