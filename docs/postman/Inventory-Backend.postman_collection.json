    {
      "name": "Agents",
      "item": [
        {
          "name": "Download agent ZIP (installer kit)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/devices/download-agent?clientId={{clientId}}&format=zip",
            "description": "Returns application/zip with README, config.json, run-agent.ps1, run-agent.mjs. Save response as .zip in Postman (Send and Download)."
          }
        },
        {
          "name": "Download agent metadata (JSON)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/devices/download-agent?clientId={{clientId}}&format=json"
          }
        },
        {
          "name": "Scan device now (live local telemetry)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/devices/{{deviceId}}/scan",
            "description": "Collects software/hardware from the backend host and ingests as this device's agent poll. Use when UI Scan now is clicked."
          }
        },
        {
          "name": "Poll (agent API key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-agent-api-key", "value": "{{agentApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpu\": \"Intel i5-1345U\",\n  \"ram\": \"16 GB\",\n  \"storageUsedPercent\": 82,\n  \"installedSoftware\": [\"Chrome\", \"VS Code\"]\n}"
            },
            "url": "{{baseUrl}}/api/v1/agents/{{agentId}}/poll"
          }
        }
      ]
    },
