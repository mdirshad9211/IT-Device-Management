# --- Server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Database (matches docker-compose.yml service "postgres") ---
DATABASE_URL="postgresql://inventory:inventory_local_pw@localhost:5432/inventory_dev?schema=public"

# Separate DB for integration tests (matches docker-compose.yml service "postgres-test")
TEST_DATABASE_URL="postgresql://inventory:inventory_local_pw@localhost:5433/inventory_test?schema=public"

# --- Auth ---
# Used to sign AppUser (Admin/Engineer/etc.) login JWTs.
JWT_SECRET="replace-with-a-long-random-string-in-every-environment"

# Used to verify per-site Agent API keys — a DIFFERENT trust boundary than AppUser JWTs.
AGENT_JWT_SECRET="replace-with-a-different-long-random-string"

# bcrypt hash of the admin secret password required to de-register an Agent (FR-AGENT-04).
# Generate with: node -e "console.log(require('bcrypt').hashSync('your-secret', 10))"
ADMIN_SECRET_PASSWORD_HASH="replace-with-a-bcrypt-hash"

# Max age of Agent.lastPollAt before GET /api/v1/qr/resolve/:qrValue returns stale_warning (ms).
QR_STALE_POLL_THRESHOLD_MS=86400000

# --- Email (Notification module — wired in a later phase) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="inventory@yourcompany.com"
